{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoVibeMix 2",
  "version": "0.1.0",
  "identifier": "com.govibemix.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "GoVibeMix 2", "width": 1440, "height": 900, "minWidth": 1060, "minHeight": 700, "resizable": true }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}

